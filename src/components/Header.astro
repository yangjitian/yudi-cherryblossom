---
interface Props {
  minimal?: boolean;
  brandHref?: string;
}

const { minimal = false, brandHref = "/" } = Astro.props;
---

<header>
  <div class="brand">
    <a href={brandHref} th:href={`@{${brandHref}}`}>
      {
        minimal && (
          <span class="brand-logo">
            <img th:if={"${site.logo}"} th:src={"${site.logo}"} alt="" />
          </span>
        )
      }
      <th:block th:text="${site.title}">雨滴·手记</th:block>
    </a>

    <span
      class="brand-clock"
      role="button"
      tabindex="0"
      aria-label="切换时间 / 日期显示"
    >
      <i class="brand-clock__dot" aria-hidden="true"></i>
      <time id="bjClock">--:--:--</time>
    </span>
  </div>

  {
    minimal ? (
      <div class="header-right">
        <a
          sec:authorize="isAnonymous()"
          class="login-entry"
          href="/login"
          th:href="@{/login}">登录</a
        >
        <button class="icon-btn" id="themeToggle" title="切换主题" type="button">
          ☾
        </button>
        <a
          sec:authorize="isAuthenticated()"
          class="icon-btn login-avatar"
          href="/uc"
          th:href="@{/uc}"
          target="_blank"
          rel="noopener"
          title="个人中心"
          aria-label="个人中心"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      </div>
    ) : (
      <div class="header-right">
        <a
          sec:authorize="isAnonymous()"
          class="login-entry"
          href="/login"
          th:href="@{/login}">登录</a
        >
        <nav class="desktop-nav">
          <a
            th:each="category : ${categoryFinder.listAll()}"
            th:href="@{${category.status.permalink}}"
            th:text="${category.spec.displayName}"
          >
          </a>
          <a href="/archives" th:href="@{/archives}">归档</a>
          <a href="/about" th:href="@{/about}">关于</a>
        </nav>

        <button class="icon-btn" id="searchToggle" title="搜索" type="button">⌕</button>

        <div class="search-box" id="searchBox">
          <form th:action="@{/search}" method="get">
            <input type="text" name="keyword" placeholder="搜索文章…" />
          </form>
        </div>

        <button class="icon-btn" id="themeToggle" title="切换主题" type="button">☾</button>
        <a
          sec:authorize="isAuthenticated()"
          class="icon-btn login-avatar"
          href="/uc"
          th:href="@{/uc}"
          target="_blank"
          rel="noopener"
          title="个人中心"
          aria-label="个人中心"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
        <button class="icon-btn hamburger" id="hamburgerBtn" title="菜单" type="button">☰</button>
      </div>
    )
  }
</header>

{
  !minimal && (
    <div class="mobile-drawer" id="mobileDrawer">
      <div class="drawer-top">
        <div class="brand">
          <th:block th:text="${site.title}">雨滴·手记</th:block>
        </div>
        <button class="icon-btn" id="drawerClose" title="关闭" type="button">
          ✕
        </button>
      </div>
      <nav>
        <a
          th:each="category : ${categoryFinder.listAll()}"
          th:href="@{${category.status.permalink}}"
          th:text="${category.spec.displayName}"
        >
        </a>
        <a href="/archives" th:href="@{/archives}">归档</a>
        <a href="/about" th:href="@{/about}">关于</a>
      </nav>
    </div>
  )
}
