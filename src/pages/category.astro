---
import Layout from "../layouts/Layout.astro";
---

<Layout petals="full">
  <Fragment slot="head">
    <title th:text="|${category.spec.displayName} - ${site.title}|"></title>
  </Fragment>

  <!-- 「好物分享」分类改用卡片网格页（条目在 Console → 主题设置 → 好物分享 维护），
       其余分类保持原来的精选 + 文章列表 -->
  <th:block th:if="${category.spec.slug == 'goods-share'}">
    <th:block th:replace="~{fragments/goodies :: body}"></th:block>
  </th:block>

  <th:block th:unless="${category.spec.slug == 'goods-share'}">
    <th:block th:if="${posts.total > 0}" th:with="featured = ${posts.items[0]}">
      <section
        class="hero"
        th:classappend="${#strings.isEmpty(featured.spec.cover)} ? 'hero--text'"
      >
        <svg
          class="hero-branch"
          viewBox="0 0 100 100"
          fill="none"
          aria-hidden="true"
        >
          <path
            class="branch"
            d="M6 96 C 26 80, 33 58, 39 40 C 44 24, 58 13, 80 6"
            stroke-width="1"
            stroke-linecap="round"></path>
          <path
            class="branch"
            d="M39 40 C 47 36, 55 34, 62 29"
            stroke-width="0.8"
            stroke-linecap="round"></path>
          <path
            class="branch"
            d="M22 62 C 28 60, 33 58, 37 54"
            stroke-width="0.7"
            stroke-linecap="round"></path>
          <path
            class="petal-static"
            d="M14,4 C9,7 6,12 6.5,17 C7,23 11,28 15.4,30 C15.6,30.15 16.4,30.15 16.6,30 C21,28 25,23 25.5,17 C26,12 23,7 18,4 C17.3,5.6 16.6,6.4 16,6.4 C15.4,6.4 14.7,5.6 14,4 Z"
            transform="translate(71.1,-3.6) scale(0.564) rotate(-30,16,16)"
          ></path>
          <path
            class="petal-static"
            d="M14,4 C9,7 6,12 6.5,17 C7,23 11,28 15.4,30 C15.6,30.15 16.4,30.15 16.6,30 C21,28 25,23 25.5,17 C26,12 23,7 18,4 C17.3,5.6 16.6,6.4 16,6.4 C15.4,6.4 14.7,5.6 14,4 Z"
            transform="translate(55.9,22.4) scale(0.39) rotate(40,16,16)"
            opacity="0.85"></path>
          <path
            class="petal-static"
            d="M14,4 C9,7 6,12 6.5,17 C7,23 11,28 15.4,30 C15.6,30.15 16.4,30.15 16.6,30 C21,28 25,23 25.5,17 C26,12 23,7 18,4 C17.3,5.6 16.6,6.4 16,6.4 C15.4,6.4 14.7,5.6 14,4 Z"
            transform="translate(33.8,34.4) scale(0.328) rotate(95,16,16)"
            opacity="0.7"></path>
          <path
            class="petal-static"
            d="M14,4 C9,7 6,12 6.5,17 C7,23 11,28 15.4,30 C15.6,30.15 16.4,30.15 16.6,30 C21,28 25,23 25.5,17 C26,12 23,7 18,4 C17.3,5.6 16.6,6.4 16,6.4 C15.4,6.4 14.7,5.6 14,4 Z"
            transform="translate(32.8,49.5) scale(0.267) rotate(150,16,16)"
            opacity="0.55"></path>
        </svg>

        <div class="hero-content">
          <img
            class="hero-cover fade-in d1"
            th:if="${not #strings.isEmpty(featured.spec.cover)}"
            th:src="${featured.spec.cover}"
            alt=""
          />
          <div class="hero-meta fade-in d2">
            <span class="featured-mark">精选文章</span>
            <span>·</span>
            <span
              th:text="${#temporals.format(featured.spec.publishTime, 'yyyy 年 MM 月 dd 日')}"
            ></span>
          </div>
          <h1 class="serif fade-in d3" th:text="${featured.spec.title}"></h1>
          <p class="fade-in d4" th:text="${featured.status.excerpt}"></p>
          <a
            class="read-link fade-in d5"
            th:href="@{${featured.status.permalink}}">阅读全文 →</a
          >
        </div>
      </section>
    </th:block>

    <div class="section-label">最新文章</div>

    <!-- post-list--collapse-series：本页把同系列文章收成一张系列卡（由 main-v3.js 完成） -->
    <div
      class="post-list post-list--collapse-series"
      data-infinite
      th:attr="data-next-url=${posts.hasNext()} ? ${posts.nextUrl} : ''"
    >
      <th:block
        th:replace="~{fragments/post-list :: list (posts=${posts}, offset=1)}"
      ></th:block>
    </div>

    <div class="empty-state" th:if="${posts.total == 0}">
      <span class="empty-mark">✿</span>
      这个分类下还没有文章
    </div>

    <div class="infinite-status" id="infiniteStatus"></div>
    <div id="infiniteSentinel"></div>
  </th:block>
</Layout>
