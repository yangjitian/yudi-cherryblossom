---
import Layout from "../layouts/Layout.astro";
---

<Layout petals="full">
  <Fragment slot="head">
    <title th:text="|归档 - ${site.title}|"></title>
  </Fragment>

  <th:block th:with="posts = ${postFinder.list({page: 1, size: 500})}">
    <div class="page-shell">
      <div class="page-heading" id="petalScope">
        <h1>归档</h1>
        <p class="page-meta">拖动或滚动左侧弧线选择年份</p>
      </div>

      <div class="arc" id="arc" th:unless="${posts.total == 0}">
        <div class="arc-axis" id="arcAxis">
          <svg id="arcSvg" width="150" height="620"></svg>
          <div class="arc-hint">滚轮 / 拖动</div>
        </div>
        <div class="arc-col">
          <div class="arc-months" id="arcMonths"></div>
        </div>
        <div class="arc-col">
          <div class="arc-posts" id="arcPosts"></div>
        </div>
      </div>

      <div class="empty-state" th:if="${posts.total == 0}">
        <span class="empty-mark">✿</span>
        还没有可归档的文章
      </div>

      <!-- 文章数据在服务端渲染成扁平列表，由 main-v3.js 按年 / 月分组后驱动弧形交互 -->
      <div id="arcSource" hidden>
        <a
          th:each="post : ${posts.items}"
          th:href="@{${post.status.permalink}}"
          th:text="${post.spec.title}"
          th:attr="data-year=${#temporals.format(post.spec.publishTime, 'yyyy')}, data-month=${#temporals.format(post.spec.publishTime, 'MM')}"
        >
        </a>
      </div>
    </div>
  </th:block>
</Layout>
