---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title th:text="|标签 - ${site.title}|"></title>
  </Fragment>

  <div class="page-shell">
    <div class="page-heading">
      <h1>标签</h1>
      <p class="page-meta" th:with="tags = ${tagFinder.listAll()}" th:text="|${#lists.size(tags)} 个标签|"></p>
    </div>

    <ul class="skill-tags" th:with="tags = ${tagFinder.listAll()}">
      <li th:each="tag : ${tags}">
        <a th:href="@{${tag.status.permalink}}" th:text="${tag.spec.displayName}"></a>
      </li>
    </ul>
  </div>
</Layout>
