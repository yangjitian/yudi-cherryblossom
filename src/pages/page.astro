---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Fragment slot="head">
    <title th:text="|${singlePage.spec.title} - ${site.title}|"></title>
  </Fragment>

  <div class="page-shell">
    <div class="page-heading">
      <h1 th:text="${singlePage.spec.title}"></h1>
      <p
        class="page-meta"
        th:text="${#temporals.format(singlePage.spec.publishTime, 'yyyy 年 MM 月 dd 日')}"
      ></p>
    </div>

    <div class="prose" th:utext="${singlePage.content.content}"></div>
  </div>
</Layout>
